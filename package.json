{
  "name": "dsh-font-settings",
  "version": "0.6.0",
  "description": "WebUI plugin: per-device font preferences (UI font + code font + terminal size) as a Settings \u2192 General row. Free-text CSS stack first, curated candidates, and opt-in local-font enumeration via queryLocalFonts()",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fuzz1og/dsh-font-settings.git"
  },
  "homepage": "https://github.com/fuzz1og/dsh-font-settings#readme",
  "bugs": {
    "url": "https://github.com/fuzz1og/dsh-font-settings/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.1.7-alpha.1 <0.2.0",
      "dshReleases": {
        "0.1.6-alpha.2": "incompatible",
        "0.1.7-alpha.1": "compatible",
        "0.1.7-alpha.2": "compatible"
      },
      "profiles": [
        "web"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "verify:disposable-profile": "node test/verify-disposable-profile.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/dsh-settings": "^0.1.7-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-settings": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "engines": {
    "node": ">=18.17.0",
    "dsh": ">=0.1.7-alpha.1 <0.2.0"
  }
}
